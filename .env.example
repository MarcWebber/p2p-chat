# 配置后，邀请链接可以在两台设备之间完成 WebRTC 信令。
# 留空时自动使用 BroadcastChannel，方便在同一浏览器的两个标签页联调。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ICE 服务器。多个地址用英文逗号分隔。
# 生产环境应配置 TURN。完整步骤见 docs/turn-configuration.md。
# 多个地址可同时覆盖 UDP、TCP 和 TLS 443；这里的凭证会进入浏览器包，请定期轮换。
NEXT_PUBLIC_STUN_URLS=stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302
NEXT_PUBLIC_TURN_URLS=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
# 仅用于 TURN 验收；正常生产保持 all，强制中继时临时设为 relay 并重新构建。
NEXT_PUBLIC_ICE_TRANSPORT_POLICY=all

# Cloudflare Realtime TURN（推荐）。长期 Token 只在服务端使用，不能加 NEXT_PUBLIC_ 前缀。
# 浏览器通过 /api/turn-credentials 获取 24 小时短时凭证。
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# 部署后的正式网址，用于生成社交分享卡片绝对地址。
NEXT_PUBLIC_SITE_URL=
